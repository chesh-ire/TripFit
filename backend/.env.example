# Copy to .env and fill in. NEVER commit the real .env.
#
# DEMO MODE: with NO credentials set, the server runs in demo mode — the whole
# app works (real weather + a rule-based outfit engine; sample itinerary/clothing
# you can edit). Add a credential below to switch to real Claude AI automatically.
#
# Option A — pay-as-you-go key (https://console.anthropic.com/):
ANTHROPIC_API_KEY=
#
# Option B — OAuth token from `ant auth login` (a Claude subscription). Leaving
# ANTHROPIC_API_KEY empty lets the SDK resolve an `ant` profile automatically,
# so you usually don't need to paste a token here.
ANTHROPIC_AUTH_TOKEN=

# Force a mode regardless of credentials: 1/true = demo, 0/false = live.
# Leave blank to auto-detect (demo when no credentials).
TRIPFIT_MOCK=

# Optional overrides
CLAUDE_MODEL=claude-opus-4-8
# Comma-separated allowed CORS origins ("*" allows all).
CORS_ORIGINS=*
